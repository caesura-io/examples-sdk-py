# Your OpenAI API key — sent only to OpenAI, never to Caesura
OPENAI_API_KEY=sk-...

# Your Caesura API key (starts with caesura_) — sent only to the Caesura backend
CAESURA_API_KEY=caesura_...

# Caesura backend URL (default: https://dev.caesura.io)
# Uncomment and change if using a different environment
# CAESURA_BASE_URL=https://dev.caesura.io
