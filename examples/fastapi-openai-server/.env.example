# Provider key: sent only to OpenAI
OPENAI_API_KEY=sk-...

# CaesuraO key: sent only to CaesuraO
CAESURA_API_KEY=caesura_...

# Create a conversation once, then reuse its returned ID (default: true)
# CAESURA_PERSIST=true

# Await analysis before the model call (default: sync)
# CAESURA_MODE=sync

# Agent receiving guidance (default: Agent); the SDK sends currentUser automatically.
# CAESURA_AGENT_NAME=Agent

# Calculation alone does not suppress duplicate guidance (default: true)
# CAESURA_CALCULATE_SIMILARITIES=true

# Optional cosine threshold. 0.5 is a test value, not a production recommendation.
# CAESURA_SIMILARITY_THRESHOLD=0.5
